{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "remotion:gold_smith",
            "is_spawnable": true,
            "is_summonable": true,
            "spawn_egg": {
                "base_color": "#FFD700",
                "overlay_color": "#8B4513"
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "goldsmith",
                    "merchant",
                    "mob"
                ]
            },
            "minecraft:behavior.look_at_player": {
                "priority": 7,
                "look_distance": 8.0,
                "probability": 0.02
            },
            "minecraft:behavior.random_stroll": {
                "priority": 8,
                "speed_multiplier": 0.8
            },
            "minecraft:behavior.random_look_around": {
                "priority": 9
            },
            "minecraft:nameable": {
                "allow_name_tag_renaming": true,
                "always_show": true
            },
            "minecraft:health": {
                "value": 40,
                "max": 40
            },
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 1.9
            },
            "minecraft:movement": {
                "value": 0.25
            },
            "minecraft:navigation.walk": {
                "can_path_over_water": true,
                "can_walk": true
            },
            "minecraft:jump.static": {},
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": 0,
                "breathes_water": false,
                "breathes_air": true
            },
            "minecraft:physics": {},
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:conditional_bandwidth_optimization": {},
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "cause": "all",
                        "deals_damage": false
                    }
                ]
            },
            "minecraft:persistent": {}
        },
        "component_groups": {
            "talk_phase": {
                "minecraft:interact": {
                    "interactions": [
                        {
                            "on_interact": {
                                "filters": {
                                    "all_of": [
                                        {
                                            "test": "is_family",
                                            "subject": "other",
                                            "value": "player"
                                        }
                                    ]
                                },
                                "event": "minecraft:on_interact"
                            },
                            "interact_text": "Talk",
                            "swing": true
                        }
                    ]
                }
            },
            "trade_phase": {
                "minecraft:trade_table": {
                    "table": "trading/gold_smith_trades.json"
                },
                "minecraft:behavior.trade_with_player": {
                    "priority": 1
                }
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "talk_phase"
                    ]
                }
            },
            "minecraft:on_interact": {},
            "remotion:open_shop": {
                "add": {
                    "component_groups": [
                        "trade_phase"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "talk_phase"
                    ]
                }
            }
        }
    }
}
